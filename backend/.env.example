# Copy this file to .env and adjust as needed.

ENV=development
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

DATABASE_URL=postgresql+psycopg://toothwise:toothwise@db:5432/toothwise

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# Flip to false once you have trained weights in models_weights/
USE_MOCK_MODEL=false
YOLOV8_WEIGHTS_PATH=models_weights/yolov8_dental.pt
YOLOV12_WEIGHTS_PATH=models_weights/yolov12_dental.pt
DETECTION_CONF_THRESHOLD=0.25
ENSEMBLE_IOU_THRESHOLD=0.5

KNN_MODEL_PATH=app/ml/artifacts/knn_recommender.joblib
KNN_NEIGHBORS=5

SEED_ADMIN_EMAIL=your-admin-email@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-random-password
SEED_ADMIN_NAME=Clinic Administrator
SEED_ADMIN_LICENSE=your-license-number

# --- Appointment confirmation email (optional - leave blank to run in
# mock/log-only mode; see app/notifications.py) ---
CLINIC_NAME=CodiSmile Dental Clinic

# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your
# address, SMTP_PASSWORD=an App Password (not your regular Gmail password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@codismile.com
SMTP_USE_TLS=true

# SMS was tried (Semaphore) but dropped for cost - these are unused by
# the current booking flow. Left here in case you switch it back on.
SMS_API_KEY=
SMS_SENDER_NAME=CodiSmile


# --- Free public AI assistant (Gemini) ---
# Keep this key server-side. Do not put it in the React frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=18

# Master switch for AI inference (YOLO ensemble + live preview). false = screening endpoints return 503.
DETECTION_ENABLED=true
