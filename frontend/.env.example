# Production API used by ToothWise staff/patient features.
REACT_APP_API_URL=https://your-toothwise-backend.example.com

# Used by the SEO component for canonical/OG URLs. Falls back to
# window.location.origin if unset, but set this explicitly in production
# so canonical tags stay stable regardless of which domain served the
# request (e.g. a Vercel preview URL vs. your real domain).
REACT_APP_SITE_URL=https://your-toothwise-domain.example.com

# Optional. Leave unset in production to use the Vercel serverless chatbot at /api/chatbot.
REACT_APP_CHATBOT_URL=/api/chatbot
